# Konflux build for the AI Grid enrollment service (RHOAI onboarding, RHOAIENG-95092).
# Mirrors deploy/enrollment/Containerfile.ubi9. FROM images pinned to @sha256 for renovate.
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:094ea2ecfd3225af8f93807b99daa9ff33710fc705ebdf6e8466f46ed605585c AS build

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake \
    && dnf clean all

# Grid pins the toolchain in rust-toolchain.toml; --default-toolchain none lets the
# first cargo invocation install exactly that pin. curl-minimal is already present.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none

WORKDIR /src
COPY . .
# sar: the ENROLLMENT_AUTHZ=kube default (TokenReview + SubjectAccessReview).
# bootstrap: the `enrollment bootstrap` subcommand the chart's pre-install Job runs.
RUN cargo build --release -p enrollment --bin enrollment \
        --features sar,bootstrap \
    && cp target/release/enrollment /usr/local/bin/enrollment

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:154811228435396156662801174566829a2c27d8a0b0f9af6e6d6e76ddf87ffe

RUN microdnf install -y --nodocs ca-certificates \
    && microdnf clean all

COPY --from=build --chmod=0555 /usr/local/bin/enrollment /usr/local/bin/enrollment

USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/usr/local/bin/enrollment"]

LABEL com.redhat.component="odh-praxis-ai-grid-enrollment-container" \
      name="odh-praxis-ai-grid-enrollment-rhel9" \
      description="Enrollment service for AI Grid site onboarding" \
      summary="Enrollment service for AI Grid site onboarding" \
      io.k8s.display-name="odh-praxis-ai-grid-enrollment" \
      io.k8s.description="odh-praxis-ai-grid-enrollment"
