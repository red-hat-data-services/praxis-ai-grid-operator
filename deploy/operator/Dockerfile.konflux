# Konflux build for the AI Grid operator (RHOAI onboarding, RHOAIENG-95092).
# Mirrors deploy/operator/Containerfile.ubi9. FROM images pinned to @sha256 for renovate.
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:094ea2ecfd3225af8f93807b99daa9ff33710fc705ebdf6e8466f46ed605585c AS build

RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake \
    && dnf clean all

# Grid pins the toolchain in rust-toolchain.toml; --default-toolchain none lets the
# first cargo invocation install exactly that pin. curl-minimal is already present.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none

WORKDIR /src
COPY . .
RUN cargo build --release -p operator --bin operator \
    && cp target/release/operator /usr/local/bin/operator

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:e8673bd338b3f093501a9a9088f043d8959df120edd9947583e2d9bb3aacc3a8

RUN microdnf install -y --nodocs ca-certificates \
    && microdnf clean all

COPY --from=build --chmod=0555 /usr/local/bin/operator /usr/local/bin/operator

USER 65532:65532
EXPOSE 9090/tcp
EXPOSE 7946/udp
ENTRYPOINT ["/usr/local/bin/operator"]

LABEL com.redhat.component="odh-praxis-ai-grid-operator-container" \
      name="odh-praxis-ai-grid-operator-rhel9" \
      description="Kubernetes operator for AI Grid multi-site inference routing" \
      summary="Kubernetes operator for AI Grid multi-site inference routing" \
      io.k8s.display-name="odh-praxis-ai-grid-operator" \
      io.k8s.description="odh-praxis-ai-grid-operator"
