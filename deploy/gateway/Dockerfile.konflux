# Konflux build for the AI Grid data-plane gateway (RHOAI onboarding, RHOAIENG-95092).
# Mirrors deploy/gateway/Containerfile.ubi9. FROM images pinned to @sha256 for renovate.
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:094ea2ecfd3225af8f93807b99daa9ff33710fc705ebdf6e8466f46ed605585c AS build

# openssl-devel/pkgconf: praxis-proxy (Pingora) links OpenSSL.
RUN dnf install -y --nodocs --setopt=install_weak_deps=0 \
        gcc gcc-c++ make cmake openssl-devel pkgconf-pkg-config \
    && dnf clean all

# Grid pins the toolchain in rust-toolchain.toml; --default-toolchain none lets the
# first cargo invocation install exactly that pin. curl-minimal is already present.
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --default-toolchain none

WORKDIR /src
COPY . .
# The gateway is its own workspace (gateway/Cargo.toml), not a root member.
RUN cargo build --release --manifest-path gateway/Cargo.toml --bin grid-gateway \
    && cp gateway/target/release/grid-gateway /usr/local/bin/grid-gateway

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:154811228435396156662801174566829a2c27d8a0b0f9af6e6d6e76ddf87ffe

RUN microdnf install -y --nodocs ca-certificates \
    && microdnf clean all

COPY --from=build --chmod=0555 /usr/local/bin/grid-gateway /usr/local/bin/grid-gateway

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/grid-gateway"]

LABEL com.redhat.component="odh-praxis-ai-grid-gateway-container" \
      name="odh-praxis-ai-grid-gateway-rhel9" \
      description="Praxis-based data-plane gateway for AI Grid" \
      summary="Praxis-based data-plane gateway for AI Grid" \
      io.k8s.display-name="odh-praxis-ai-grid-gateway" \
      io.k8s.description="odh-praxis-ai-grid-gateway"
